<comment>
problem   =  simple monte carlo test
reference =
configure = --prob=mctest -mc

<job>
problem_id = MCTest   # problem ID: basename of output filenames

#<output1>
#file_type  = hst       # History data dump
#dt         = 0.01      # time increment between outputs

<output1>
file_type  = spec
face       = outer_x3
ne         = 100
emin      = 1.0
emax      = 1.0e2
ncth      = 8
nphi      = 8

<output2>
file_type  = list

<time>
cfl_number = 0.4       # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = 1        # cycle limit
tlim       = 1.0      # time limit

<mesh>
nx1        = 64       # Number of zones in X1-direction
x1min      = -5.0e10       # minimum value of X1
x1max      = 5.0e10      # maximum value of X1
ix1_bc     = periodic  # inner-X1 boundary flag
ox1_bc     = periodic  # outer-X1 boundary flag
ix1_mc_bc     = periodic  # inner-X1 boundary flag
ox1_mc_bc     = periodic  # outer-X1 boundary flag

nx2        = 64         # Number of zones in X2-direction
x2min      = -5.0e10      # minimum value of X2
x2max      = 5.0e10       # maximum value of X2
ix2_bc     = periodic  # inner-X2 boundary flag
ox2_bc     = periodic  # outer-X2 boundary flag
ix2_mc_bc  = periodic  # inner-X2 boundary flag
ox2_mc_bc  = periodic  # outer-X2 boundary flag

nx3        = 128         # Number of zones in X3-direction
x3min      = 0.0        # minimum value of X3
x3max      = 1.0e11       # maximum value of X3
ix3_bc     = outflow  # inner-X3 boundary flag
ox3_bc     = outflow  # outer-X3 boundary flag
ix3_mc_bc  = absorb  # inner-X3 boundary flag
ox3_mc_bc  = escape  # outer-X3 boundary flag

num_threads = 1        # maximum number of OMP threads

<hydro>
gamma = 1.666666666666667 # gamma = C_p/C_v
iso_sound_speed = 1.0     # isothermal sound speed

<montecarlo>
mcranks   = 10
nphot     = 10000000
cadence   = 1000000
iseed     = 121500
emin      = 1.0
emax      = 300.0
scattering = thomson
emission   = freefree
absorption = freefree
polarized = true

<problem>
temp     = 1.0e5       # isothermal temperature
rho      = 1.0e-10     # density
taumin   = 1.0e-3
taumax   = 1.0e4
