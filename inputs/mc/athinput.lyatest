<comment>
problem   =  Lyman alpha escape from uniform isothermal sphere
reference =
configure = --prob=lyatest -mc

<job>
problem_id = lya   # problem ID: basename of output filenames

#<output1>
#file_type  = hst       # History data dump
#dt         = 0.01      # time increment between outputs

<output3>
file_type = phlist
relativistic = true
nuser     = 1

<mesh>
nx1        = 1       # Number of zones in X1-direction
x1min      = -5.0e11       # minimum value of X1
x1max      = 5.0e11      # maximum value of X1
ix1_mc_bc  = absorb  # inner-X1 boundary flag
ox1_mc_bc  = absorb  # outer-X1 boundary flag

nx2        = 1         # Number of zones in X2-direction
x2min      = -5.0e11      # minimum value of X2
x2max      = 5.0e11       # maximum value of X2
ix2_mc_bc  = absorb  # inner-X2 boundary flag
ox2_mc_bc  = absorb  # outer-X2 boundary flag

nx3        = 1         # Number of zones in X3-direction
x3min      = -5.0e11        # minimum value of X3
x3max      = 5.0e11       # maximum value of X3
ix3_mc_bc  = absorb  # inner-X3 boundary flag
ox3_mc_bc  = absorb  # outer-X3 boundary flag

<hydro>
gamma = 1.666666666666667 # gamma = C_p/C_v

<montecarlo>
nphot     = 1000
iseed     = 121501
scattering = resonance
polarized = false

<problem>
temp     = 1.0e4       # isothermal temperature
tau      = 1.0e6     # line center optical depth
radius   = 1.e11
x0 = 0.
