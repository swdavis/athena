<comment>
problem   =  Test movement through spherical grid using general mover                    or spherical mover
reference =
configure = --prob=mc_sph_tran -mc --coord=spherical_polar

<job>
problem_id = sphtran   # problem ID: basename of output filenames

<output1>
file_type  = phlist
relativistic = true
nuser     = 4

<mesh>
nx1        = 128       # Number of zones in X1-direction
x1min      = 0.01       # minimum value of X1
x1max      = 1.0e11     # maximum value of X1
ix1_mc_bc  = absorb  # inner-X1 boundary flag
ox1_mc_bc  = escape  # outer-X1 boundary flag

nx2        = 64         # Number of zones in X2-direction
x2min      = 0.      # minimum value of X2
x2max      = 3.1415926535   # maximum value of X2-
ix2_mc_bc  = polar  # inner-X2 boundary flag
ox2_mc_bc  = polar  # outer-X2 boundary flag

nx3        = 64        # Number of zones in X3-direction
x3min      = 0.0       # minimum value of X3
x3max      = 6.2831853071 # maximum value of X3
ix3_mc_bc  = periodic  # inner-X3 boundary flag
ox3_mc_bc  = periodic  # outer-X3 boundary flag

<hydro>
gamma = 1.666666666666667 # gamma = C_p/C_v

<montecarlo>
nphot     = 1000
iseed     = 134440
scattering = none
emission   = freefree
absorption = none
polarized = false
stepsize = 1.000000e-02
general_mover = true
varystep = true
checkmove = 100000000

<problem>
